      "ParcelCategory": {
        "type": "string",
        "enum": [
          "CLOTHES",
          "SHOES",
          "FASHION_ACCESSORIES",
          "OTHER_ACCESSORIES",
          "BOOKS",
          "DOCUMENTS",
          "SMALL_TOYS",
          "PHONE",
          "COMPUTER",
          "OTHER_ELECTRONICS",
          "CHECKED_BAG_23KG",
          "CABIN_BAG_12KG"
        ],
        "description": "Enum actuel (pré-D14). La migration vers les 8 familles de risque CAT-02 fera l'objet d'une PR dédiée (mapping conservé)."
      },
      "TripAction": {
        "type": "string",
        "enum": [
          "edit",
          "publish",
          "unpublish",
          "pause",
          "resume",
          "cancel",
          "restore",
          "archive",
          "delete"
        ],
        "description": "Actions de la state machine trip (canPerform/getAllowedActions). Renvoyées dans allowedActions pour piloter les CTAs front."
