        "example": "665f1c2ab3d4e5f6a7b8c9d0"
      },
      "TripStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "PUBLISHED",
          "PAUSED",
          "COMPLETED",
          "CANCELLED",
          "ARCHIVED"
        ]
      },
      "TransportMode": {
        "type": "string",
        "enum": [
          "PLANE",
          "TRAIN",
          "CAR"
        ]
      },
      "TripType": {
        "type": "string",
        "enum": [
          "ONE_WAY",
          "ROUND_TRIP"
