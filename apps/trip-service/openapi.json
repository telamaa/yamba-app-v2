      "TicketVerificationStatus": {
        "type": "string",
        "enum": [
          "NOT_SUBMITTED",
          "PENDING",
          "VERIFIED",
          "REJECTED"
        ]
      },
      "LocationKind": {
        "type": "string",
        "enum": [
          "AIRPORT",
          "TRAIN_STATION",
          "CITY_AREA"
        ]
      },
      "LocationFlexibility": {
        "type": "string",
        "enum": [
          "EXACT",
          "RADIUS",
          "CITY_WIDE"
