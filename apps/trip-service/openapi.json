{
  "openapi": "3.1.0",
  "info": {
    "title": "Yamba — Trip Service API",
    "version": "0.1.0",
    "description": "Contrats générés depuis @packages/api-contracts (Zod v4, source de vérité unique — D3). Les clients consomment l'API via le gateway (:8080, préfixe /api) ; ce service écoute en direct sur :6002."
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "API Gateway (dev)"
    },
    {
      "url": "http://localhost:6002",
      "description": "trip-service direct (debug)"
    }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "summary": "Ce document OpenAPI 3.1",
        "operationId": "getOpenApiDocument",
        "responses": {
          "200": {
            "description": "Document OpenAPI 3.1 (généré depuis Zod)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
