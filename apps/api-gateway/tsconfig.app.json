{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node",
      "express"
    ],
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "allowSyntheticDefaultImports": true,
    "rootDir": "../../",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "../../packages/**/*.ts"
  ],
  "exclude": [
    "../../packages/**/*.spec.ts"
  ]
}
