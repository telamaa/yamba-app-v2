<!DOCTYPE html>
<html lang="<%= locale %>">
<head><meta charset="UTF-8" /><title><%= subject %></title></head>
<body style="margin:0;padding:0;background-color:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0f172a;">
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#f8fafc;">
    <tr>
        <td align="center" style="padding:32px 16px;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width:560px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px -4px rgba(0,0,0,0.06);">
                <tr>
                    <td style="background:linear-gradient(135deg,#0F766E 0%,#14b8a6 100%);padding:32px 24px;text-align:center;">
                        <h1 style="margin:0;color:#ffffff;font-size:22px;font-weight:800;letter-spacing:-0.5px;">
                            <%= locale === "fr" ? "Paiement autorisé" : "Payment authorized" %>
                        </h1>
                    </td>
                </tr>
                <tr>
                    <td style="padding:32px 24px;">
                        <p style="margin:0 0 16px 0;font-size:16px;line-height:1.6;">
                            <%= locale === "fr" ? `Bonjour ${firstName},` : `Hi ${firstName},` %>
                        </p>
                        <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#334155;">
                            <%= locale === "fr"
                                    ? `Ce reçu confirme l'autorisation de paiement pour ta demande d'envoi ${route} (${weightKg} kg).`
                                    : `This receipt confirms the payment authorization for your shipping request ${route} (${weightKg} kg).` %>
                        </p>
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#f0fdfa;border-radius:12px;margin:0 0 16px 0;">
                            <tr>
                                <td style="padding:16px 20px;">
                                    <p style="margin:0;font-size:13px;color:#0F766E;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">
                                        <%= locale === "fr" ? "Montant autorisé" : "Authorized amount" %>
                                    </p>
                                    <p style="margin:4px 0 0 0;font-size:24px;font-weight:800;color:#0F766E;"><%= amount %></p>
                                </td>
                            </tr>
                        </table>
                        <p style="margin:0 0 24px 0;font-size:14px;line-height:1.6;color:#64748b;">
                            <%= locale === "fr"
                                    ? "Rien n'est débité tant que le Voyageur n'a pas accepté. S'il refuse ou ne répond pas sous 24 h, l'autorisation est levée et tu n'es pas débité·e."
                                    : "Nothing is charged until the carrier accepts. If they decline or do not answer within 24 hours, the authorization is released and you are not charged." %>
                        </p>
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center">
                            <tr>
                                <td style="background-color:#FF9900;border-radius:12px;">
                                    <a href="<%= ctaUrl %>" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;">
                                        <%= locale === "fr" ? "Suivre ma demande" : "Track my request" %>
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:20px 24px;background-color:#f8fafc;text-align:center;">
                        <p style="margin:0;font-size:12px;color:#94a3b8;">Yamba</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
