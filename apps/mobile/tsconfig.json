{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@packages/api-contracts/locale": [
        "../../packages/libs/api-contracts/src/locale.ts"
      ],
      "@packages/legal/versions": [
        "../../packages/libs/legal/versions.ts"
      ],
      "@packages/pricing": [
        "../../packages/libs/pricing/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js",
    "jest.config.ts",
    "jest.setup.ts",
    "**/*.spec.ts",
    "src/test-support"
  ]
}
