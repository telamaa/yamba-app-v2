{
  "expo": {
    "name": "Yamba",
    "slug": "yamba",
    "owner": "telamas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yamba",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.telama.yamba",
      "adaptiveIcon": {
        "backgroundColor": "#FF9900",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.telama.yamba"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF9900",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yamba joint tes photos au colis pour prouver son état au départ.",
          "cameraPermission": "Yamba utilise l'appareil photo pour photographier ton colis avant l'envoi."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78cf22fe-7ca9-4b1b-8d85-c24291659f45"
      }
    }
  }
}
