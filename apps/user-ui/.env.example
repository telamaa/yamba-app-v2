NEXT_PUBLIC_SERVER_URI="http://192.168.1.155:8080"
NEXT_PUBLIC_USER_UI_LINK="http://192.168.1.155:3000"

# D48 — API en même origine (recommandé en dev et en recette LAN) :
# Next sert /api/* en proxy vers le gateway → cookies first-party sur tout hôte.
# Laisser API_PROXY_TARGET vide pour l'ancien mode (URL absolue vers :8080).
API_PROXY_TARGET=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api
# Adresse support affichée sur les écrans de litige (B4-PR2/PR3). Défaut : support@yamba.app
NEXT_PUBLIC_SUPPORT_EMAIL=""
