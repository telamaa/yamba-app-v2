{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "composite": false,
    "rootDir": "../..",
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "noEmit": true,
    "outDir": "./out-tsc"
  },
  "include": ["playwright.config.ts", "src/**/*.ts"]
}
