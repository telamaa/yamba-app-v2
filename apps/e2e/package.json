{
  "name": "@yamba-app/e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "npx playwright test --config=apps/e2e/playwright.config.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "e2e-ui": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "npx playwright test --config=apps/e2e/playwright.config.ts --ui",
          "cwd": "{workspaceRoot}"
        }
      },
      "e2e-rapport": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "npx playwright show-report apps/e2e/rapport",
          "cwd": "{workspaceRoot}"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "npx tsc --noEmit --project apps/e2e/tsconfig.json",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
