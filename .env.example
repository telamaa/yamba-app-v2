DATABASE_URL=""
REDIS_DATABASE_URI=""
SMTP_USER=""
SMTP_PASS=""
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_FROM="Yamba <no-reply@yamba.app>"
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
USER_APP_URL=http://192.168.1.155:3000
CORS_ORIGIN=http://localhost:3000,http://192.168.1.155:3000
STRIPE_SECRET_KEY=""
# Clé publiable Stripe (pk_test_…) — Payment Element du wizard de réservation (B2). Sans STRIPE_SECRET_KEY, deal-service utilise le fournisseur FAKE (dev uniquement).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Secret de signature du webhook Stripe (whsec_…) — D40. En dev : `stripe listen --forward-to localhost:6003/webhooks/stripe` (le secret est affiché au lancement). Sans lui, POST /webhooks/stripe répond 501.
STRIPE_WEBHOOK_SECRET=""
# Secret du SECOND endpoint Stripe (même URL /webhooks/stripe, coché « événements des comptes connectés ») : account.updated, transfer.reversed, payout.failed (A87)
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Cron d'expiration 24 h des demandes (deal-service, B2-PR2) — false pour une instance API pure (même logique que OUTBOX_RELAY_ENABLED).
BOOKING_EXPIRY_CRON_ENABLED=""
# Cron de versement J+4 + rejeu des versements + rappel J+3 (deal-service, B4) — false pour une instance API pure.
BOOKING_PAYOUT_CRON_ENABLED=""
# Récapitulatif quotidien « argent à surveiller » envoyé à SUPPORT_EMAIL (deal-service, A88) — false pour le couper.
OPS_DIGEST_CRON_ENABLED=""
# Alertes de seuil horaires (deal-service, C-PR6b) : email au support à la première apparition d'une règle dans la journée — false pour couper.
OPS_ALERTS_CRON_ENABLED=""
# Cron notation : relances J+5/J+7 et révélation des avis à 14 j (deal-service, B5) — false pour couper.
RATING_CRON_ENABLED=""
# Clé AES-256-GCM du code de livraison (D43, B3) — 32 octets en base64 : `openssl rand -base64 32`.
# Hors production, absente = clé de développement dérivée (avertissement au démarrage) ; en production, absente = refus au pickup.
DELIVERY_CODE_ENCRYPTION_KEY=""

# D47 — Connexion Google (Google Identity Services). Même client ID côté front
# (NEXT_PUBLIC_…, vérifie l'audience) et côté auth-service (vérifie le jeton).
# Console Google Cloud → Identifiants → ID client OAuth 2.0 « Application Web »,
# origines JavaScript autorisées : http://localhost:3000 (+ IP LAN, + prod).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Adresse support rappelée dans les emails de litige (notification-service, B4/D52). Défaut : support@yamba.app
SUPPORT_EMAIL=""

# ── Chantier C — admin (D54, 8A) ─────────────────────────────────────────────
# Clé AES-256-GCM du secret TOTP des comptes admin (openssl rand -base64 32).
# Hors production : clé de dev dérivée + avertissement ; en production : obligatoire.
TOTP_ENCRYPTION_KEY=
# Nom affiché dans l'application d'authentification.
ADMIN_TOTP_ISSUER="Yamba Admin"
# Session admin : inactivité (min) · vie absolue (h) · pré-authentification (min).
ADMIN_SESSION_INACTIVITY_MINUTES=45
ADMIN_SESSION_LIFETIME_HOURS=12
ADMIN_PREAUTH_MINUTES=5
# URL publique de l'admin-ui (liens des emails d'invitation, C-PR3).
ADMIN_UI_URL=http://localhost:3001
# Chantier F (D61) — message-service (chat + rendez-vous). Relais outbox : false pour le couper.
MESSAGE_SERVICE_PORT=6005
MESSAGING_RELAY_ENABLED=""
# F-PR3 — relance email des messages non lus (toutes les 5 min) et purge nocturne à un an : false pour couper.
MESSAGING_REMINDER_CRON_ENABLED=""
MESSAGING_RETENTION_CRON_ENABLED=""

# ── Observabilité (C-PR3, D56 7A) — vide = Sentry inactif ─────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# C-PR8c (D64) — maintenance forcée au gateway (le jour où Mongo est la panne) ; sinon l'état vit en base (admin → État des services)
# MAINTENANCE_MODE=on
# MAINTENANCE_MESSAGE_FR=Maintenance en cours, la plateforme est en lecture seule.
# MAINTENANCE_MESSAGE_EN=Maintenance in progress, the platform is read-only.
# Page « État des services » : URLs des services sondés (défauts : localhost:8080 / 6001…6005)
# GATEWAY_URL=http://localhost:8080
# APP_VERSION=dev
