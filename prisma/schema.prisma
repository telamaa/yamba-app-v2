generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName       String
  lastName        String
  email           String
  emailNormalized String    @unique
  passwordHash    String?
  phoneNumber     String?
  phoneE164       String?
  gender          Gender?
  birthDate       DateTime?
  roles           Role[]    @default([SHIPPER])

  // D44 — langue des emails et de l'interface (code court : "fr", "en", …).
  // Initialisée à l'inscription depuis l'en-tête x-locale, mise à jour quand
  // l'utilisateur bascule la langue dans le header. Liste : SUPPORTED_LOCALES.
  preferredLocale String    @default("fr")

  // Slug public unique pour la page profil /u/[slug]
  publicSlug String? @unique

  // Stats shipper (notes reçues en tant qu'expéditeur)
  shipperRatingsAvg   Float @default(0)
  shipperRatingsCount Int   @default(0)
  parcelsSentCount    Int   @default(0)

  // Carrier onboarding
  carrierStatus CarrierStatus @default(NONE)

  // Relations
  avatar      Image?       @relation("UserAvatar")
  carrierPage CarrierPage?
  addresses   Address[]
  trips       Trip[]       @relation("UserTrips")

  // Reviews unifiées
  reviewsReceived Review[] @relation("ReviewSubject")
  reviewsGiven    Review[] @relation("ReviewAuthor")

  // Système de follow
  following UserFollow[] @relation("UserFollowing")
  followers UserFollow[] @relation("UserFollowers")

  // Alertes de route
  savedRoutes SavedRoute[]

  consentLogs ConsentLog[]

  // Lifecycle
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([carrierStatus])
  @@index([roles])
  @@index([phoneE164])
}

// ─────────────────────────────────────────────
// CONSENT LOG (RGPD)
// ─────────────────────────────────────────────

model ConsentLog {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now())

  ipAddress String?
  userAgent String?
  locale    String?

  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([userId, type, acceptedAt])
  @@index([type, version])
}

// ─────────────────────────────────────────────
// CARRIER PAGE
// ─────────────────────────────────────────────

model CarrierPage {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profil public
  name        String
  bio         String?
  phoneE164   String?
  avatar      Image?  @relation("CarrierAvatar")
  coverUrl    String?
  socialLinks Json[]  @default([])

  // Localisation publique
  primaryAddressId String?  @db.ObjectId // A42 : plus de @unique — sur Mongo deux pages sans adresse collisionnent sur null (P2002) ; l'adresse est créée par le service pour UNE page (unicité par construction)
  primaryAddress   Address? @relation("CarrierPrimaryAddress", fields: [primaryAddressId], references: [id])

  // Onboarding tracking
  onboardingStep OnboardingStep @default(PROFILE)

  // Stripe Connect
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)
  stripeChargesEnabled     Boolean @default(false)
  stripePayoutsEnabled     Boolean @default(false)

  // Badges
  isVerified     Boolean @default(false)
  isSuperCarrier Boolean @default(false)

  // Stats
  totalTripsPublished Int   @default(0)
  totalParcelsCarried Int   @default(0)
  totalTripsCancelled Int   @default(0)
  ratingsAvg          Float @default(0)
  ratingsCount        Int   @default(0)

  // Relations
  trips Trip[]

  // Rappels onboarding
  lastReminderSentAt DateTime?
  reminderCount      Int       @default(0)

  // Lifecycle
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeAccountId])
  @@index([isVerified])
  @@index([isSuperCarrier])
  @@index([ratingsAvg])
  @@index([primaryAddressId]) // A42 — index simple (jointure), non unique
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────

model Review {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  subjectUserId String @db.ObjectId
  subjectUser   User   @relation("ReviewSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  authorUserId String @db.ObjectId
  authorUser   User   @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  kind ReviewKind

  bookingId String? @db.ObjectId

  rating  Float
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectUserId])
  @@index([authorUserId])
  @@index([subjectUserId, kind])
  @@index([subjectUserId, kind, createdAt])
}

// ─────────────────────────────────────────────
// USER FOLLOW
// ─────────────────────────────────────────────

model UserFollow {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  followerId String @db.ObjectId
  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followedId String @db.ObjectId
  followed   User   @relation("UserFollowers", fields: [followedId], references: [id], onDelete: Cascade)

  notifyNextTrip Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([followerId, followedId])
  @@index([followerId])
  @@index([followedId])
}

// ─────────────────────────────────────────────
// SAVED ROUTE (alertes de route)
// ─────────────────────────────────────────────
// L'utilisateur sauvegarde une intention de voyage. Quand un Tripper publie
// un trajet qui match, on lui envoie un email.
//
// Matching intelligent (cross-locale safe via codes ISO et placeId) :
//   - Score 100 : placeId identique OU (countryCode + city normalisée identique)
//   - Score 70  : countryCode identique + distance < 50km (haversine)
//
// Cycle de vie :
//   - expiresAt = latestDate + 1j  (si dates fournies)
//   - expiresAt = createdAt + 6 mois (sinon)
//   - Cron quotidien : warn à J-7, désactive à J
// ─────────────────────────────────────────────

model SavedRoute {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ─── Origine (snapshot Google Places) ───
  originCity        String
  originCityCode    String? // ✨ NEW — IATA si dispo
  originCountry     String // Affichage (locale-dependent)
  originCountryCode String // ISO 3166-1 alpha-2 (ex: "FR")
  originRegion      String? // ✨ NEW — affichable
  originRegionCode  String? // ✨ NEW — ISO 3166-2 (ex: "FR-75")
  originPlaceId     String?
  originLat         Float?
  originLng         Float?

  // ─── Destination (snapshot Google Places) ───
  destinationCity        String
  destinationCityCode    String? // ✨ NEW
  destinationCountry     String
  destinationCountryCode String
  destinationRegion      String? // ✨ NEW
  destinationRegionCode  String? // ✨ NEW
  destinationPlaceId     String?
  destinationLat         Float?
  destinationLng         Float?

  // ─── Période (optionnelle) ───
  earliestDate DateTime?
  latestDate   DateTime?

  // ─── Préférences notif ───
  emailEnabled  Boolean @default(true)
  inAppEnabled  Boolean @default(false)
  includeNearby Boolean @default(true)

  // ─── Cycle de vie ───
  expiresAt           DateTime
  expiryWarningSentAt DateTime?
  isActive            Boolean   @default(true)

  // ─── Anti-spam runtime ───
  lastNotifiedAt DateTime?

  // ─── Métadonnées ───
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@index([originCountryCode, destinationCountryCode, isActive])
  @@index([expiresAt, isActive])
}

// ─────────────────────────────────────────────
// IMAGE
// ─────────────────────────────────────────────

model Image {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  fileId String
  url    String

  userId String? @unique @db.ObjectId
  user   User?   @relation("UserAvatar", fields: [userId], references: [id], onDelete: Cascade)

  carrierPageId String?      @unique @db.ObjectId
  carrierPage   CarrierPage? @relation("CarrierAvatar", fields: [carrierPageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// ADDRESS
// ─────────────────────────────────────────────

model Address {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String?

  formattedAddress String?
  placeId          String?
  lat              Float?
  lng              Float?

  streetLine1 String?
  streetLine2 String?
  city        String?
  region      String?
  postalCode  String?
  country     String?
  countryCode String?

  recipientName String?
  phoneE164     String?

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  carrierPage CarrierPage[] @relation("CarrierPrimaryAddress") // A42 : liste déclarative (Prisma exige @unique pour un 1-1) — une adresse n'est jamais partagée par construction

  @@index([userId])
  @@index([userId, isArchived])
  @@index([placeId])
  @@index([city])
  @@index([country])
  @@index([countryCode])
}

// ─────────────────────────────────────────────
// TRIP
// ─────────────────────────────────────────────

type TripCategoryCondition {
  category         ParcelCategory
  priceAmountCents Int
}

// Lieu de remise ou livraison défini par le Voyageur pour CE trajet.
// Le Voyageur définit, l'Expéditeur s'adapte ou ne réserve pas.
// Seuls les lieux activés côté Draft (enabled=true) sont persistés.
type TripLocationPoint {
  kind        LocationKind
  details     String?
  flexibility LocationFlexibility
  radiusKm    Int? // uniquement défini quand flexibility = RADIUS (5, 10, 15, 20)
}

model Trip {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation("UserTrips", fields: [userId], references: [id], onDelete: Cascade)

  carrierPageId String?      @db.ObjectId
  carrierPage   CarrierPage? @relation(fields: [carrierPageId], references: [id])

  status      TripStatus @default(DRAFT)
  currentStep Int        @default(1)

  transportMode TransportMode?
  tripType      TripType       @default(ONE_WAY)

  // ─── Origin ──────────────────────────────────────
  originLabel       String?
  originPlaceId     String?
  originCity        String?
  originCityCode    String? // IATA (CDG, JFK) si dispo
  originRegion      String? // Texte affichable (locale-dependent)
  originRegionCode  String? // ✨ NEW — ISO 3166-2 (ex: "FR-75", "CZ-PR")
  originCountry     String? // Texte affichable (locale-dependent)
  originCountryCode String? // ✨ NEW — ISO 3166-1 alpha-2 ("FR", "CZ")
  originLat         Float?
  originLng         Float?
  originTimezone    String?

  // ─── Destination ─────────────────────────────────
  destinationLabel       String?
  destinationPlaceId     String?
  destinationCity        String?
  destinationCityCode    String?
  destinationRegion      String?
  destinationRegionCode  String? // ✨ NEW
  destinationCountry     String?
  destinationCountryCode String? // ✨ NEW
  destinationLat         Float?
  destinationLng         Float?
  destinationTimezone    String?

  // ─── Dates ───────────────────────────────────────
  departureDateLocal String?
  arrivalDateLocal   String?
  departureTimeLocal String?
  arrivalTimeLocal   String?

  departureAt DateTime?
  arrivalAt   DateTime?

  returnDepartureAt DateTime?
  returnArrivalAt   DateTime?

  departureHourLocal Int?

  // ─── Mode-specific ───────────────────────────────
  flightType         FlightType?
  trainTripType      TrainTripType?
  carTripFlexibility CarTripFlexibility?

  flightLayoverCities String[] @default([])
  trainStopCities     String[] @default([])

  travelReference String?

  // ─── Conditions / pricing ────────────────────────
  acceptedCategories ParcelCategory[]        @default([])
  categoryConditions TripCategoryCondition[]
  // ⭐ D13/D14 — moteur PER_KG du Trip (PR pricing socle, A28).
  // Bi-moteur TOLERANT : nullable, les trips PER_CATEGORY existants
  // restent valides ; le gate de publication exige UN moteur COMPLET.
  pricePerKgCents Int?
  // PRC-04 — bagages entiers forfaitaires (null = non propose).
  checkedBag23PriceCents Int?
  cabinBag12PriceCents   Int?
  // CAT-02 — conditions par FAMILLE de risque (nouveau moteur) ;
  // l'ancien categoryConditions reste INTACT jusqu'au cleanup.
  familyConditions TripFamilyCondition[]

  // ─── Lieux de remise / livraison ─────────────────
  // Le Voyageur définit où l'Expéditeur dépose le colis (pickup)
  // et où il le récupère (delivery), pour CE trajet précis.
  pickupLocations   TripLocationPoint[]
  deliveryLocations TripLocationPoint[]

  handDeliveryOnly Boolean @default(false)
  instantBooking   Boolean @default(false)

  minPriceCents Int?

  /// D33 — coût de transport d'un colis de référence 2 kg (cents), dénormalisé
  /// pour trier/comparer PER_KG et legacy ensemble. Recalculé à chaque écriture.
  comparablePriceCents Int?

  carrierRatingSnapshot Float?

  ticketVerificationStatus TicketVerificationStatus @default(NOT_SUBMITTED)

  currencyCode String @default("EUR")

  // ─── Capacité ────────────────────────────────────
  // ⭐ B1 (CAP-01 / D19) — capacité en KG, unité officielle du produit.
  // capacityKg : déclaration du Voyageur (immuable après publication ;
  //   nullable pour les trips legacy, requis au gate de publication
  //   après la refonte du formulaire création).
  // reservedKg : compteur atomique ($inc dans la transaction de
  //   création/libération du booking).
  //   INVARIANT vérifiable : reservedKg === Σ poids des bookings actifs.
  //   remainingKg = capacityKg − reservedKg, DÉRIVÉ, jamais stocké.
  capacityKg Float?
  reservedKg Float  @default(0)

  /// @deprecated — capacité en slots remplacée par capacityKg/reservedKg.
  /// Conservés pour ne pas casser le wizard création actuel.
  /// Suppression : PR cleanup post-refonte pricing (D13).
  maxSlots    Int?
  bookedSlots Int  @default(0)

  notes String?

  documents TripDocument[]

  publishedAt DateTime?
  cancelledAt DateTime?
  archivedAt  DateTime?

  // ⭐ Lifecycle hardening (Lot 1/2) — soft delete des brouillons
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Indexes ─────────────────────────────────────
  @@index([userId])
  @@index([carrierPageId])
  @@index([status])
  @@index([transportMode])
  @@index([departureAt])
  @@index([publishedAt])
  @@index([userId, status])
  @@index([userId, isDeleted]) // ⭐ Lot 1/2 — requête chaude getMyTrips
  @@index([originPlaceId])
  @@index([destinationPlaceId])
  @@index([status, departureAt, transportMode])
  @@index([minPriceCents])
  @@index([comparablePriceCents])
  @@index([carrierRatingSnapshot])
  @@index([departureHourLocal])
  @@index([originCity])
  @@index([destinationCity])
  @@index([originCountryCode, destinationCountryCode, status]) // ✨ NEW — matching SavedRoute
  @@index([originCountryCode]) // ✨ NEW
  @@index([destinationCountryCode]) // ✨ NEW
}

model TripDocument {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tripId String @db.ObjectId
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  uploadedByUserId String? @db.ObjectId

  type   TripDocumentType
  status TripDocumentStatus @default(PENDING)

  fileId       String
  url          String
  originalName String?
  mimeType     String?
  sizeBytes    Int?

  title       String?
  description String?

  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([tripId, type])
  @@index([status])
}

// ─────────────────────────────────────────────
// BOOKING (deal-service — chantier B1)
// ─────────────────────────────────────────────
// Le Booking est AUTO-SUFFISANT : snapshots figés à la création
// (trip, pricing, colis, destinataire) pour que le deal reste lisible
// même si le Trip est modifié, annulé ou purgé (RGPD). Esprit D17
// étendu au-delà du prix.
//
// Volontairement SANS relations Prisma vers Trip/User (ObjectId
// indexés uniquement) : pas de cascade accidentelle sur l'historique
// transactionnel — les jointures sont explicites dans les services.
// ─────────────────────────────────────────────

// D17 — snapshot pricing IMMUABLE, prime de protection SÉPARÉE (GAR-04).
// Agnostique au modèle de pricing : PER_CATEGORY (moteur actuel,
// TripCategoryCondition forfaitaire) ou PER_KG (cible D13 post-refonte).
// Un changement de moteur ne migre JAMAIS les bookings existants.
type BookingPricingSnapshot {
  pricingModel PricingModel

  weightKg Float

  // PER_CATEGORY (présent)
  categoryPriceCents Int?

  // PER_KG (futur — €/kg × classe S/M/L)
  pricePerKgCents Int?
  sizeClass       String? // "S" | "M" | "L"

  // Faits figés, communs aux deux modèles
  transportCents  Int // = net Voyageur (COM-03)
  commissionPct   Float // figé à la création (COM-04)
  commissionCents Int // plancher déjà appliqué (D16)

  // Protection (D22) — flux séparé du transport
  protectionProvider String? // "YAMBA_GUARANTEE" | assureur embedded
  protectionTier     String?
  premiumCents       Int     @default(0)

  totalShipperCents Int
  currencyCode      String @default("EUR")
  // D34 (B2) — devis figé tel quel depuis @packages/pricing ; optionnels
  // car les snapshots antérieurs (seed PER_CATEGORY) ne les portent pas.
  product            String? // "PARCEL" | "CHECKED_BAG_23KG" | "CABIN_BAG_12KG"
  billableWeightKg   Float? // max(poids, 0,5) — D32
  sizeCoef           Float? // 1 / 1,1 / 1,25
  familySurchargePct Float? // supplément Voyageur de la famille (CAT-03)
  rawTransportCents  Int? // avant plancher 8 €
  minimumApplied     Boolean? // plancher D32 appliqué
  serviceCents       Int? // commission + prime (COM-03, 2e ligne)
}

// B2 — lieu de remise / de retrait choisi par l'Expéditeur parmi les
// points du trajet (figé : le trajet peut changer, le rendez-vous non).
type BookingPlaceSnapshot {
  kind    LocationKind
  details String?
}

// Auto-suffisance : le trip peut changer, le booking garde sa vérité.
// Deux fuseaux IANA (D24) : le pickup se raisonne côté origine,
// l'ETA d'arrivée côté destination.
type BookingTripSnapshot {
  originCity             String
  originCountryCode      String?
  originTimezone         String?
  destinationCity        String
  destinationCountryCode String?
  destinationTimezone    String?
  departureAt            DateTime // UTC
  transportMode          String?
}

type BookingParcelSnapshot {
  category           ParcelCategory
  categoryFamily     String? // D14 — mapping 8 familles FIGÉ à la création
  description        String
  declaredValueCents Int
  photoUrls          String[] // R2, horodatées (spec §9)
}

type BookingRecipientSnapshot {
  firstName String
  lastName  String
  phoneE164 String
  email     String? // optionnel à la demande (spec É1 : « pour notifications si renseigné »)
}

type BookingPickupInfo {
  confirmedAt DateTime
  photoUrls   String[] // ImageKit (D42), 1..5, horodatées serveur
  notes       String?
  checklist   String[] @default([]) // B3 — les 5 points d'inspection cochés (CNF-04, attestation figée)
}

// Événements optionnels DANS l'état PICKED_UP — hors machine d'états
// (validateur séquentiel séparé : canConfirmTrackingStep).
type BookingTrackingEvent {
  step        String // AT_AIRPORT | FLIGHT_DEPARTED | FLIGHT_ARRIVED
  confirmedAt DateTime
}

model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tripId    String @db.ObjectId
  shipperId String @db.ObjectId // User
  carrierId String @db.ObjectId // User — dénormalisé (deals de "Mes trajets")

  status BookingStatus @default(PENDING)

  trip      BookingTripSnapshot
  pricing   BookingPricingSnapshot
  parcel    BookingParcelSnapshot
  recipient BookingRecipientSnapshot
  pickupPlace   BookingPlaceSnapshot?
  deliveryPlace BookingPlaceSnapshot?

  // ─── Jalons (horodatage SERVEUR) + échéances pré-calculées ───
  requestedAt   DateTime      @default(now())
  expiresAt     DateTime // requestedAt + 24h (cron B2)
  acceptedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  payoutDueAt   DateTime? // deliveredAt + J+4 (cron B4)
  completedAt   DateTime?
  closedAt      DateTime? // DECLINED / EXPIRED / CANCELLED
  closedBy      BookingActor?
  declineReason String? // refus PENDING (5 raisons — DeclineReason du contrat)
  cancelReason  String? // annulation Expéditeur (texte libre court, B2)
  pickupRefusalReason String? // refus au pickup (5 raisons — PickupRefusalReason, B3/A40)

  // ─── Code de livraison (spec §9 — le serveur est seul juge) ───
  deliveryCodeHash    String? // bcrypt — JAMAIS dans un payload carrier (validation seule)
  deliveryCodeEncrypted String? // AES-256-GCM (D43) — ré-affichage Expéditeur SEUL, en PICKED_UP, jamais en liste/event/email
  codeRegenerations   Int       @default(0) // ≤ MAX_CODE_REGENERATIONS (5)
  deliveryAttempts    Int       @default(0) // ≤ MAX_DELIVERY_ATTEMPTS (3)
  deliveryLockedUntil DateTime? // lock DELIVERY_LOCK_MINUTES (15)

  pickup         BookingPickupInfo?
  trackingEvents BookingTrackingEvent[]

  // ─── Paiement — colonnes prêtes, remplies en B2/B4 ───
  paymentIntentId   String? // référence PaymentProvider (D11) — autorisation manuelle, capture à l'acceptation
  paymentProvider   String? // "STRIPE" | "FAKE" (dev/tests uniquement)
  capturedAt        DateTime?
  refundedAt        DateTime?
  refundAmountCents Int?
  transferId        String?

  // ─── Litige ───
  disputeTicket String? // YAM-XXXX
  disputedAt    DateTime?

  // ─── Lifecycle / RGPD ───
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tripId, status]) // hasActiveBookings + deals par trajet
  @@index([shipperId, status]) // Mes envois
  @@index([carrierId, status]) // deals Mes trajets
  @@index([status, expiresAt]) // cron expiration 24h (B2)
  @@index([status, payoutDueAt]) // cron versement J+4 (B4)
}

// ─────────────────────────────────────────────
// OUTBOX (D2 — aucun événement perdu, dès B1)
// ─────────────────────────────────────────────
// Écrit dans la MÊME transaction Mongo que tout changement d'état.
// Le relay (PR4) publie vers Redpanda/Kafka puis pose publishedAt.

model OutboxEvent {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  aggregateType String // "booking"
  aggregateId   String    @db.ObjectId
  eventType     String // "booking.requested", "booking.accepted", …
  payload       Json
  correlationId String?
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime? // null = à publier (relay PR4)

  // Poison handling (A24, PR4) : échec de validation/publication →
  // attempts++ ; à MAX_RELAY_ATTEMPTS (10) la row est PARQUÉE (exclue
  // de la requête du relay, JAMAIS supprimée — audit trail). Trade-off
  // documenté : parquer libère les événements suivants de l'agrégat.
  attempts    Int       @default(0)
  lastError   String? // dernier message d'erreur (validation Zod ou broker)
  lastErrorAt DateTime?

  @@index([publishedAt, occurredAt]) // requête du relay (batch trié)
}

// ─────────────────────────────────────────────
// RELAY LEASE (A24 — un seul relay actif)
// ─────────────────────────────────────────────
// L'ordre par aggregateId exige UN SEUL publieur. Lease à expiration :
// acquisition atomique (updateMany conditionnel), heartbeat à chaque
// tick, expiration = reprenable par une autre instance. Permet le
// scaling horizontal du deal-service sans double publication.

model RelayLease {
  id        String   @id @map("_id") // clé fixe : "outbox-relay" (un doc par relay)
  owner     String // identité d'instance : hostname#pid#uuid
  expiresAt DateTime // renouvelé à chaque tick ; passé = lease libre

  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// REPORT (signalements — scope B1, registre)
// ─────────────────────────────────────────────

model Report {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  reporterUserId String @db.ObjectId

  targetType ReportTargetType
  targetId   String           @db.ObjectId

  reason  String
  details String?

  status ReportStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([reporterUserId])
}

